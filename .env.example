# Copy to .env for local development. Never commit real credentials.
AGENTHUB_ENVIRONMENT=local
AGENTHUB_LOG_LEVEL=INFO
AGENTHUB_DATABASE_HOST=127.0.0.1
AGENTHUB_DATABASE_PORT=5432
AGENTHUB_DATABASE_NAME=agenthub
AGENTHUB_DATABASE_USER=agenthub
AGENTHUB_DATABASE_PASSWORD=
AGENTHUB_REDIS_URL=redis://127.0.0.1:6379/0
AGENTHUB_DEPENDENCY_TIMEOUT_SECONDS=3
AGENTHUB_SESSION_TTL_SECONDS=3600
AGENTHUB_DATABASE_POOL_SIZE=5

# Required by Compose. Set a unique password before starting containers.
POSTGRES_PASSWORD=
