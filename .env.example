# Copy to .env for local development. Never commit real credentials.
AGENTHUB_ENVIRONMENT=local
AGENTHUB_LOG_LEVEL=INFO
AGENTHUB_DATABASE_HOST=127.0.0.1
AGENTHUB_DATABASE_PORT=5432
AGENTHUB_DATABASE_NAME=agenthub
AGENTHUB_DATABASE_USER=agenthub
AGENTHUB_DATABASE_PASSWORD=
AGENTHUB_REDIS_URL=redis://127.0.0.1:6379/0
AGENTHUB_DEPENDENCY_TIMEOUT_SECONDS=3
AGENTHUB_SESSION_TTL_SECONDS=3600
AGENTHUB_DATABASE_POOL_SIZE=5

# OpenAI-compatible base URL INCLUDING /v1 when required. Empty disables generation.
# Only configure a trusted server: prompts and this provider key are sent to it.
AGENTHUB_MODEL_BASE_URL=
AGENTHUB_MODEL_API_KEY=
AGENTHUB_MODEL_NAME=
AGENTHUB_MODEL_TIMEOUT_SECONDS=60
AGENTHUB_MODEL_MAX_TOKENS=1024
AGENTHUB_MODEL_CONTEXT_CHARACTERS=24000
# Enable only if the selected service supports stream_options.include_usage.
AGENTHUB_MODEL_INCLUDE_USAGE=false
# DeepSeek basic text chat: set disabled. Other services: omit this provider extension.
AGENTHUB_MODEL_THINKING_MODE=provider_default

# Model Studio Beijing: replace YOUR_WORKSPACE_ID, or leave URL empty to disable.
# AGENTHUB_EMBEDDING_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
AGENTHUB_EMBEDDING_BASE_URL=
AGENTHUB_EMBEDDING_API_KEY=
AGENTHUB_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
AGENTHUB_EMBEDDING_DIMENSIONS=1024
AGENTHUB_EMBEDDING_TIMEOUT_SECONDS=30
AGENTHUB_EMBEDDING_BATCH_SIZE=10
AGENTHUB_EMBEDDING_MAX_CHARACTERS=8000

# Host path; Compose always uses its shared document_data volume.
AGENTHUB_DOCUMENT_STORAGE_PATH=data/documents
AGENTHUB_DOCUMENT_MAX_BYTES=5000000
AGENTHUB_DOCUMENT_MAX_CHARACTERS=200000
AGENTHUB_DOCUMENT_MAX_CHUNKS=500
AGENTHUB_DOCUMENT_MAX_PAGES=200
AGENTHUB_DOCUMENT_PARSE_TIMEOUT_SECONDS=30
AGENTHUB_WORKER_POLL_SECONDS=5

# Required by Compose. Set a unique password before starting containers.
POSTGRES_PASSWORD=
